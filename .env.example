# انسخ هذا الملف إلى .env وعدّل القيمة حسب إعداداتك
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# مسار النشر — لازم يطابق اسم المستودع على GitHub Pages (بيتحط في الـ workflow تلقائياً)
# سيبها فاضية في التطوير المحلي
# NEXT_PUBLIC_BASE_PATH=/SaddamBarbe

# رقم الواتساب الاحتياطي بالصيغة الدولية من غير + ومن غير مسافات.
# الافتراضي هو رقم الفرع الأساسي، فمش محتاج تكتبه إلا لو عايز تغيّره.
# NEXT_PUBLIC_WHATSAPP=201061402242

# أرقام الفروع وعناوينها ومواعيدها (والرقم اللي بيظهر للزوار) موجودة في:
#   src/data/branches.ts      ← بيانات كل فرع
#   src/data/site-config.ts   ← بتاخد الفرع الأساسي من branches.ts تلقائياً
