# ==============================================================================
# SADDAM BARBER - متغيرات البيئة (Environment Variables)
# ==============================================================================
# انسخ هذا الملف إلى .env في بيئة التطوير المحلي،
# وأضف نفس المتغيرات في لوحة تحكم Vercel (Settings -> Environment Variables).

# ------------------------------------------------------------------------------
# 1. إعدادات Supabase (الأساسية والموصى بها)
# ------------------------------------------------------------------------------
# احصل على هذه القيم من Supabase Dashboard -> Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# مفتاح Service Role اختياري للعمليات الإدارية الخلفية (لا يُعرض للواجهة الأمامية أبداً):
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# اسم سلة تخزين الصور في Supabase Storage (الافتراضي: saddam-media):
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=saddam-media

# ------------------------------------------------------------------------------
# 2. حماية لوحة التحكم (/admin)
# ------------------------------------------------------------------------------
# كلمة سر احتياطية للوحة التحكم (في حال عدم استخدام Supabase Auth):
ADMIN_PASSWORD=saddam2026

# نص عشوائي لتوقيع جلسة الأدمن الاحتياطية:
# ADMIN_SECRET=any-long-random-string-for-session-signing

# ------------------------------------------------------------------------------
# 3. إعدادات قاعدة البيانات المباشرة (PostgreSQL / Drizzle - اختياري)
# ------------------------------------------------------------------------------
# لو أردت الاتصال المباشر بـ PostgreSQL / Neon / Supabase Direct DB:
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. مسار النشر لـ GitHub Pages (اختياري - اتركه فارغاً لـ Vercel والتطوير المحلي)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_PATH=/SaddamBarber
